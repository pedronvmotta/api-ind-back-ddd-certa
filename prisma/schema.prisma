generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Leitor{
  id Int @id @default(autoincrement())
  email String @unique
  nome String 
  cpf String @unique
  dataNascimento DateTime
  endereco String
  observacao String?

  emprestimos Emprestimo[] // um leitor pode ter vários empréstimos
}

model Emprestimo {
  id Int @id @default(autoincrement())
  data_emprestimo DateTime
  prazo_de_devolucao DateTime
  observacoes String
  id_leitor Int // FK
  leitor Leitor @relation(fields: [id_leitor], references: [id])
  itens_emprestimo ItemEmprestimo[] // um emprestimo pode ter vários itens de empréstimo
}

model ItemEmprestimo{
  id Int @id @default(autoincrement())
  data_de_devolucao DateTime
  valor_multa Int
  status String
  id_emprestimo Int // FK
  id_livro Int // FK

  emprestimo Emprestimo @relation(fields: [id_emprestimo], references: [id])

  livro Livro @relation(fields: [id_livro], references: [id])
}

model Livro{
  id Int @id  @default(autoincrement())
  nome_livro String
  editora String
  versao String
  ano String
  genero String
  idioma String
  qtde_total Int
  qtde_disponivel Int

  itens_emprestimo ItemEmprestimo[] //um livro pode ser emprestado N vezes (ser itemEmprestimo N vezes)

  autores Autor[] // um livro pode ter N autores
}

model Autor{
  id Int @id @default(autoincrement())
  nome_autor String
  origem String
  biografia String
  data_de_nascimento DateTime
  nome_artistico String
  id_livro Int // FK

  livro Livro @relation(fields: [id_livro], references: [id]) 
}

