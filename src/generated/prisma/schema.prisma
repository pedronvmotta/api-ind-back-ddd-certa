generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Leitor {
  id                 Int          @id @default(autoincrement())
  email              String?      @unique
  nome               String
  cpf                String       @unique
  endereco           String
  observacao         String?
  data_de_nascimento DateTime
  emprestimos        Emprestimo[]
}

model Autor {
  id                 Int      @id @default(autoincrement())
  nome_autor         String
  origem             String
  biografia          String
  data_de_nascimento DateTime
  nome_artistico     String
  id_livro           Int
  Livro              Livro    @relation(fields: [id_livro], references: [id])
}

model Livro {
  id               Int              @id @default(autoincrement())
  nome_livro       String
  editora          String
  versao           String
  ano              String
  genero           String
  idioma           String
  qtde_total       Int
  qtde_disponivel  Int
  Autor            Autor[]
  itens_emprestimo ItemEmprestimo[]
}

model Emprestimo {
  id                 Int              @id @default(autoincrement())
  data_emprestimo    DateTime
  prazo_de_devolucao DateTime
  observacoes        String
  id_leitor          Int
  leitor             Leitor           @relation(fields: [id_leitor], references: [id])
  itens_emprestimo   ItemEmprestimo[]
}

model ItemEmprestimo {
  id                Int        @id @default(autoincrement())
  data_de_devolucao DateTime
  valor_multa       Int
  status            String
  id_emprestimo     Int
  id_livro          Int
  emprestimo        Emprestimo @relation(fields: [id_emprestimo], references: [id])
  livro             Livro      @relation(fields: [id_livro], references: [id])
}
